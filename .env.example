KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC=sighthog-raw-events
INGEST_API_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Optional: MaxMind GeoLite2-Country.mmdb (place file in infra/geoip/)
GEOLITE2_DB_PATH=/geo/GeoLite2-Country.mmdb
SDK_ENDPOINT=http://localhost:8080/v1/events
NEXT_PUBLIC_SDK_ENDPOINT=http://localhost:8080/v1/events
SDK_FLUSH_INTERVAL_MS=5000

DATABASE_URL=postgres://sighthog_user:sighthog_password@postgres:5432/sighthog_metadata?sslmode=disable

CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_DATABASE=sighthog
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=password

SEAWEEDFS_ENDPOINT=http://seaweedfs:8333
SEAWEEDFS_BUCKET=sighthog-replays
SEAWEEDFS_ACCESS_KEY=any
SEAWEEDFS_SECRET_KEY=any

WORKERS_KAFKA_BROKERS=kafka:9092
WORKERS_KAFKA_TOPIC=sighthog-raw-events
CLICKHOUSE_BATCH_SIZE=2000
CLICKHOUSE_BATCH_INTERVAL_MS=3000
BLOB_FLUSH_INTERVAL_MS=30000

CLICKHOUSE_HTTP_URL=http://clickhouse:8123
NEXT_PUBLIC_DEMO_URL=http://localhost:3001
DEMO_URL=http://localhost:3001
